                     unsynchronized = true;
                 }
 
-                int tagSize = 0;
                 for (int i = 6, shift = 21; i < 10; i++) {
                     tagSize += (buf[i] & 0x7f) << shift;
                     shift -= 7;
                 }
 
+                if (!validateTagSize()) {
+                    return; // Abort parser if tag size is invalid.
+                }
+
                 startRawMetadata(tagSize + 10);
                 stuffRawMetadata(buf, 0, 10); // put the header back in the raw metadata blob
