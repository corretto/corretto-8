-			<xsl:if test="@name='xsltExtFunctionLookup' or
-					@name='xsltMatchPattern'">
-				<xsl:text>/*</xsl:text>
-			</xsl:if>
-			<xsl:value-of select="@name"/>
-			<xsl:if test="self::variable">
-				<xsl:text> DATA</xsl:text>
-			</xsl:if>
-			<xsl:if test="@name='xsltExtFunctionLookup' or
-					@name='xsltMatchPattern'">
-				<xsl:text>*/</xsl:text>
-			</xsl:if>
-			<xsl:text>&nl;</xsl:text>
-		</xsl:for-each>
-	</xsl:template>
-</xsl:stylesheet>
